<div style="max-width: 760px;">
  <div style="margin-bottom: 24px;">
    <h1 style="font-size: 24px; font-weight: 800; color: var(--color-text);">Haftalık Müsaitlik Saatleri</h1>
    <p style="font-size: 14px; color: var(--color-text-secondary); margin-top: 4px;">
      Davetlilerinizin sadece belirlediğiniz gün ve çalışma saatleri arasında randevu almasını sağlayın.
    </p>
  </div>

  <% time_options = (0..23).flat_map { |h| ["%02d:00" % h, "%02d:30" % h] } %>

  <%= form_with url: panel_availability_rules_path, method: :post, local: true do |f| %>
    <div class="card" style="padding: 12px 24px;">
      <% (1..7).each do |day| %>
        <% rule = @rules[day] %>
        <% is_active = rule.present? %>
        <% start_val = rule&.start_time ? (rule.start_time.is_a?(Time) ? rule.start_time.strftime("%H:%M") : rule.start_time.to_s[0..4]) : "09:00" %>
        <% end_val = rule&.end_time ? (rule.end_time.is_a?(Time) ? rule.end_time.strftime("%H:%M") : rule.end_time.to_s[0..4]) : "17:00" %>

        <div class="day-row" id="day_row_<%= day %>">
          <div style="display: flex; align-items: center; gap: 12px; min-width: 160px;">
            <input type="hidden" name="rules[<%= day %>][active]" value="0">
            <input type="checkbox"
                   name="rules[<%= day %>][active]"
                   id="active_<%= day %>"
                   value="1"
                   <%= 'checked' if is_active %>
                   style="width: 18px; height: 18px; cursor: pointer;"
                   onchange="document.getElementById('hours_<%= day %>').style.opacity = this.checked ? '1' : '0.35'; document.getElementById('hours_<%= day %>').querySelectorAll('select').forEach(s => s.disabled = !this.checked);">
            <label for="active_<%= day %>" class="day-name" style="cursor: pointer; margin-bottom: 0;">
              <%= AvailabilityRule::DAY_NAMES[day] %>
            </label>
          </div>

          <div id="hours_<%= day %>" class="day-hours" style="opacity: <%= is_active ? '1' : '0.35' %>; transition: opacity 0.2s;">
            <select name="rules[<%= day %>][start_time]" class="form-select" style="width: 120px;" <%= 'disabled' unless is_active %>>
              <% time_options.each do |opt| %>
                <option value="<%= opt %>" <%= 'selected' if start_val == opt %>><%= opt %></option>
              <% end %>
            </select>
            <span style="color: var(--color-text-secondary); font-weight: 600;">-</span>
            <select name="rules[<%= day %>][end_time]" class="form-select" style="width: 120px;" <%= 'disabled' unless is_active %>>
              <% time_options.each do |opt| %>
                <option value="<%= opt %>" <%= 'selected' if end_val == opt %>><%= opt %></option>
              <% end %>
            </select>
          </div>
        </div>
      <% end %>
    </div>

    <div style="margin-top: 24px; display: flex; justify-content: flex-end;">
      <%= submit_tag "Müsaitlik Saatlerini Kaydet", class: "btn btn-primary", style: "padding: 12px 28px;" %>
    </div>
  <% end %>
</div>
