<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Whenly - Panel" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="panel-wrapper">
      <aside class="sidebar" id="panel-sidebar">
        <a href="<%= panel_root_path %>" class="sidebar-brand" style="background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: #fff; border-bottom: none;">
          <img src="/icon.svg" width="28" height="28" alt="" style="filter: brightness(0) invert(1);">
          Whenly
        </a>

        <nav class="sidebar-nav">
          <%= link_to panel_root_path, class: "nav-link #{'active' if current_page?(panel_root_path) || controller_name == 'dashboard'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Randevular
          <% end %>

          <%= link_to panel_event_types_path, class: "nav-link #{'active' if controller_name == 'event_types'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            Randevu Türleri
          <% end %>

          <%= link_to panel_availability_rules_path, class: "nav-link #{'active' if controller_name == 'availability_rules'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Müsaitlik
          <% end %>

          <%= link_to edit_panel_profile_path, class: "nav-link #{'active' if controller_name == 'profile'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Profil & Hesap
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <%= button_to session_path, method: :delete, class: "nav-link btn-link", style: "background: none; border: none; width: 100%; text-align: left; cursor: pointer;" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Çıkış Yap
          <% end %>
        </div>
      </aside>

      <main class="main-content">
        <div class="top-bar">
          <div style="display: flex; align-items: center; gap: 12px;">
            <button class="mobile-menu-toggle" onclick="document.getElementById('panel-sidebar').classList.toggle('open')">
              &#9776;
            </button>
            <span style="font-weight: 600; color: var(--color-text-secondary);">
              Hoş geldin, <strong style="color: var(--color-text);"><%= current_user&.name %></strong>
            </span>
            <span class="badge badge-primary" style="font-size: 11px; padding: 2px 8px;">Ev Sahibi</span>
          </div>

          <div style="display: flex; align-items: center; gap: 8px;">
            <%= link_to client_root_path, class: "btn btn-sm btn-outline", style: "display: inline-flex; align-items: center; gap: 6px;" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              Danışan / Katılımcı Paneli
            <% end %>
            <%= link_to "/#{current_user&.slug}/#{current_user&.event_types&.first&.slug}", target: "_blank", class: "btn btn-sm btn-primary", title: "Rezervasyon sayfasını yeni sekmede görüntüle" do %>
              Rezervasyon Sayfam &rarr;
            <% end if current_user&.event_types&.any? %>
          </div>
        </div>

        <% if flash.any? %>
          <% flash.each do |type, message| %>
            <div class="flash flash-<%= type == 'notice' ? 'notice' : 'alert' %>">
              <span><%= message %></span>
              <button type="button" class="flash-close" onclick="this.closest('.flash').remove()">&times;</button>
            </div>
          <% end %>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
