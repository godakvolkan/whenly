<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "SlotWise - Panel" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="panel-wrapper">
      <aside class="sidebar" id="panel-sidebar">
        <a href="<%= panel_root_path %>" class="sidebar-brand">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          SlotWise
        </a>

        <nav class="sidebar-nav">
          <%= link_to panel_root_path, class: "nav-link #{'active' if current_page?(panel_root_path) || controller_name == 'dashboard'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Randevular
          <% end %>

          <%= link_to panel_event_types_path, class: "nav-link #{'active' if controller_name == 'event_types'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            Randevu Türleri
          <% end %>

          <%= link_to panel_availability_rules_path, class: "nav-link #{'active' if controller_name == 'availability_rules'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Müsaitlik
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <%= button_to session_path, method: :delete, class: "nav-link btn-link", style: "background: none; border: none; width: 100%; text-align: left; cursor: pointer;" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Çıkış Yap
          <% end %>
        </div>
      </aside>

      <main class="main-content">
        <div class="top-bar">
          <div style="display: flex; align-items: center; gap: 12px;">
            <button class="mobile-menu-toggle" onclick="document.getElementById('panel-sidebar').classList.toggle('open')">
              &#9776;
            </button>
            <span style="font-weight: 600; color: var(--color-text-secondary);">
              Hoş geldin, <strong style="color: var(--color-text);"><%= current_user&.name %></strong>
            </span>
          </div>

          <div>
            <%= link_to "/#{current_user&.slug}/#{current_user&.event_types&.first&.slug}", target: "_blank", class: "btn btn-sm btn-outline", title: "Rezervasyon sayfasını yeni sekmede görüntüle" do %>
              Rezervasyon Sayfam &rarr;
            <% end if current_user&.event_types&.any? %>
          </div>
        </div>

        <% if flash.any? %>
          <% flash.each do |type, message| %>
            <div class="flash flash-<%= type == 'notice' ? 'notice' : 'alert' %>">
              <span><%= message %></span>
              <button type="button" class="flash-close" onclick="this.closest('.flash').remove()">&times;</button>
            </div>
          <% end %>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
