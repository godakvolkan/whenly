<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Whenly - Panel" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="panel-wrapper">
      <aside class="sidebar" id="panel-sidebar">
        <a href="<%= panel_root_path %>" class="sidebar-brand" style="display: flex; align-items: center; gap: 10px; padding: 20px; text-decoration: none; border-bottom: 1px solid var(--color-border); background: #ffffff;">
          <img src="/icon.svg" width="32" height="32" alt="Whenly" style="border-radius: 8px; box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);">
          <span style="font-weight: 800; font-size: 20px; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Whenly</span>
        </a>

        <nav class="sidebar-nav">
          <%= link_to panel_root_path, class: "nav-link #{'active' if current_page?(panel_root_path) || controller_name == 'dashboard'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            Randevular
          <% end %>

          <%= link_to panel_event_types_path, class: "nav-link #{'active' if controller_name == 'event_types'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            Randevu Türleri
          <% end %>

          <%= link_to panel_availability_rules_path, class: "nav-link #{'active' if controller_name == 'availability_rules'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Müsaitlik
          <% end %>

          <%= link_to edit_panel_profile_path, class: "nav-link #{'active' if controller_name == 'profile'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Profil & Hesap
          <% end %>

          <%= link_to panel_api_info_path, class: "nav-link #{'active' if controller_name == 'api_info'}" do %>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
            </svg>
            API & Token
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <%= link_to edit_panel_profile_path, class: "user-profile-snippet", style: "display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--radius-sm); text-decoration: none; margin-bottom: 8px; background: rgba(79, 70, 229, 0.05); border: 1px solid rgba(79, 70, 229, 0.12);", title: "Profil ayarlarını düzenle" do %>
            <div style="width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; flex-shrink: 0;">
              <%= current_user&.name.to_s.split.map(&:first).join.upcase.presence || "W" %>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="font-size: 13px; font-weight: 700; color: var(--color-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= current_user&.name %></div>
              <div style="font-size: 11px; color: var(--color-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Profil & Hesap &rarr;</div>
            </div>
          <% end %>

          <%= button_to session_path, method: :delete, class: "nav-link btn-link", style: "background: none; border: none; width: 100%; text-align: left; cursor: pointer; padding: 8px 12px;" do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Çıkış Yap
          <% end %>
        </div>
      </aside>

      <main class="main-content">
        <div class="top-bar">
          <div style="display: flex; align-items: center; gap: 12px;">
            <button class="mobile-menu-toggle" onclick="document.getElementById('panel-sidebar').classList.toggle('open')">
              &#9776;
            </button>
            <div style="display: flex; align-items: center; gap: 10px;">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);">
                <%= current_user&.name.to_s.split.map(&:first).join.upcase.presence || "W" %>
              </div>
              <div>
                <div style="font-weight: 700; font-size: 14px; color: var(--color-text); line-height: 1.2;">
                  <%= current_user&.name %>
                </div>
                <div style="display: flex; align-items: center; gap: 6px; margin-top: 2px;">
                  <span class="badge badge-primary" style="font-size: 10px; padding: 1px 6px;">Ev Sahibi</span>
                  <%= link_to "/#{current_user&.slug}", target: "_blank", style: "font-size: 11.5px; color: var(--color-primary); text-decoration: none; font-weight: 600;", title: "Genel profil sayfanızı görüntüleyin" do %>
                    whenly.me/<%= current_user&.slug %> &nearr;
                  <% end if current_user&.slug.present? %>
                </div>
              </div>
            </div>
          </div>

          <div style="display: flex; align-items: center; gap: 8px;">
            <%= link_to edit_panel_profile_path, class: "btn btn-sm btn-outline", style: "display: inline-flex; align-items: center; gap: 6px;", title: "Profil ve hesap ayarları" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <span>Profilim</span>
            <% end %>
            <%= link_to client_root_path, class: "btn btn-sm btn-outline", style: "display: inline-flex; align-items: center; gap: 6px;", title: "Danışan randevu takip paneli" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              <span>Danışan Paneli</span>
            <% end %>
            <%= link_to "/#{current_user&.slug}", target: "_blank", class: "btn btn-sm btn-primary", style: "display: inline-flex; align-items: center; gap: 6px;", title: "Rezervasyon sayfasını yeni sekmede görüntüle" do %>
              <span>Rezervasyon Sayfam</span>
              <span>&rarr;</span>
            <% end if current_user&.slug.present? %>
          </div>
        </div>

        <% if flash.any? %>
          <% flash.each do |type, message| %>
            <div class="flash flash-<%= type == 'notice' ? 'notice' : 'alert' %>">
              <span><%= message %></span>
              <button type="button" class="flash-close" onclick="this.closest('.flash').remove()">&times;</button>
            </div>
          <% end %>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>
