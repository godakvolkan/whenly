<!DOCTYPE html>
<html lang="tr">
  <head>
    <title><%= content_for(:title) || "Whenly - Danışan Paneli" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      .client-header {
        background: #ffffff;
        border-bottom: 1px solid var(--color-border);
        position: sticky;
        top: 0;
        z-index: 40;
        box-shadow: var(--shadow-sm);
      }
      .client-header-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .client-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        font-size: 20px;
        color: var(--color-text);
        text-decoration: none;
      }
      .client-role-badge {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 9999px;
        background: rgba(99, 102, 241, 0.1);
        color: #4F46E5;
      }
      .client-content {
        max-width: 1200px;
        margin: 32px auto;
        padding: 0 24px;
      }
      .user-menu-pill {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #f8fafc;
        border: 1px solid var(--color-border);
        padding: 6px 14px;
        border-radius: 9999px;
        font-size: 13px;
      }
    </style>
  </head>

  <body style="background: var(--color-bg); min-height: 100vh;">
    <header class="client-header">
      <div class="client-header-inner">
        <div style="display: flex; align-items: center; gap: 16px;">
          <a href="<%= client_root_path %>" class="client-brand">
            <img src="/icon.svg" width="32" height="32" alt="Whenly">
            <span>Whenly</span>
          </a>
          <span class="client-role-badge">Danışan & Katılımcı Paneli</span>
        </div>

        <div style="display: flex; align-items: center; gap: 14px;">
          <div class="user-menu-pill">
            <span style="color: var(--color-text-secondary);">👤</span>
            <strong style="color: var(--color-text);"><%= current_user&.name %></strong>
            <span style="color: var(--color-text-secondary); font-size: 12px;">(<%= current_user&.email_address %>)</span>
          </div>

          <%= link_to panel_root_path, class: "btn btn-sm btn-outline", style: "display: inline-flex; align-items: center; gap: 6px;", title: "Ev Sahibi randevu yönetimine geç" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            Ev Sahibi Paneli
          <% end %>

          <%= button_to session_path, method: :delete, class: "btn btn-sm btn-outline btn-danger", style: "display: inline-flex; align-items: center; gap: 4px;" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Çıkış Yap
          <% end %>
        </div>
      </div>
    </header>

    <main class="client-content">
      <% if flash.any? %>
        <% flash.each do |type, message| %>
          <div class="flash flash-<%= type == 'notice' ? 'notice' : 'alert' %>" style="margin-bottom: 24px;">
            <span><%= message %></span>
            <button type="button" class="flash-close" onclick="this.closest('.flash').remove()">&times;</button>
          </div>
        <% end %>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
