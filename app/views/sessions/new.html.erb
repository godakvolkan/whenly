<div class="auth-page-wrapper">
  <div class="auth-card">
    <!-- Logo ve Başlık -->
    <div class="auth-header">
      <div class="auth-logo-badge">
        <img src="/icon.svg" width="36" height="36" alt="Whenly">
      </div>
      <h1 class="auth-title">Whenly'ye Hoş Geldiniz</h1>
      <p class="auth-subtitle">Randevularınızı ve takviminizi kolayca yönetin</p>
    </div>

    <!-- Giriş / Kayıt Geçiş Sekmeleri -->
    <div class="auth-tabs">
      <%= link_to "Giriş Yap", login_path, class: "auth-tab active" %>
      <%= link_to "Kayıt Ol", signup_path, class: "auth-tab" %>
    </div>

    <% if flash[:alert] %>
      <div class="auth-alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="auth-notice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>

    <!-- Giriş Formu -->
    <%= form_with url: session_path, local: true, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "E-Posta Adresi", class: "auth-label" %>
        <div class="input-with-icon">
          <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "ornek@eposta.com", value: params[:email_address], class: "auth-input" %>
        </div>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <%= form.label :password, "Şifre", class: "auth-label", style: "margin-bottom: 0;" %>
          <%= link_to "Şifremi unuttum", new_password_path, class: "auth-link-sm" %>
        </div>
        <div class="input-with-icon">
          <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72, class: "auth-input" %>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <%= form.submit "Giriş Yap", class: "auth-btn-primary" %>
      </div>
    <% end %>

    <div class="auth-footer">
      <span>Hesabınız yok mu?</span>
      <%= link_to "Hemen Ücretsiz Kayıt Olun", signup_path, class: "auth-link-bold" %>
    </div>
  </div>
</div>
