<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
  <div class="card" style="width: 100%; max-width: 440px; padding: 36px 32px; box-shadow: var(--shadow-lg);">
    <div style="text-align: center; margin-bottom: 28px;">
      <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: var(--color-primary-light); color: var(--color-primary); border-radius: 12px; margin-bottom: 12px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <h1 style="font-size: 22px; font-weight: 800; color: var(--color-text);">Slotla Host Paneli</h1>
      <p style="font-size: 14px; color: var(--color-text-secondary); margin-top: 4px;">
        Randevularınızı ve müsaitlik kurallarınızı yönetin
      </p>
    </div>

    <%= form_with url: session_path do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "E-Posta Adresi", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "demo@slotwise.dev", value: (params[:email_address] || "demo@slotwise.dev"), class: "form-input" %>
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <%= form.label :password, "Şifre", class: "form-label" %>
          <%= link_to "Şifremi unuttum", new_password_path, style: "font-size: 12px; color: var(--color-primary);" %>
        </div>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", value: "password123", maxlength: 72, class: "form-input" %>
      </div>

      <div style="margin-top: 24px;">
        <%= form.submit "Giriş Yap", class: "btn btn-primary", style: "width: 100%; justify-content: center; padding: 12px;" %>
      </div>
    <% end %>

    <div style="margin-top: 24px; padding: 12px 14px; background: var(--color-bg); border-radius: 8px; font-size: 13px; color: var(--color-text-secondary); border: 1px dashed var(--color-border);">
      <strong>Demo Giriş Bilgileri:</strong><br>
      E-posta: <code>demo@slotwise.dev</code><br>
      Şifre: <code>password123</code>
    </div>
  </div>
</div>
