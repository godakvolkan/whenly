<div class="auth-page-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-logo-badge">
        <img src="/icon.svg" width="36" height="36" alt="Whenly">
      </div>
      <h1 class="auth-title">Şifrenizi mi Unuttunuz?</h1>
      <p class="auth-subtitle">E-posta adresinize şifre sıfırlama talimatlarını göndereceğiz</p>
    </div>

    <% if flash[:alert] %>
      <div class="auth-alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <%= form_with url: passwords_path, local: true, class: "auth-form" do |form| %>
      <div class="form-group">
        <%= form.label :email_address, "E-Posta Adresiniz", class: "auth-label" %>
        <div class="input-with-icon">
          <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "ornek@eposta.com", value: params[:email_address], class: "auth-input" %>
        </div>
      </div>

      <div style="margin-top: 24px;">
        <%= form.submit "Şifre Sıfırlama Bağlantısı Gönder", class: "auth-btn-primary" %>
      </div>
    <% end %>

    <div class="auth-footer">
      <span>Şifrenizi hatırladınız mı?</span>
      <%= link_to "Giriş Ekranına Dön", login_path, class: "auth-link-bold" %>
    </div>
  </div>
</div>
