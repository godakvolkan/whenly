<div class="public-booking-layout">
  <div style="width: 100%; max-width: 680px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 0 4px;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;">
        <img src="/icon.svg" width="24" height="24" alt="Whenly" style="border-radius: 6px;">
        <span style="font-weight: 800; font-size: 17px; color: var(--color-primary);">Whenly</span>
      </a>
      <%= link_to "/#{@booking.user.slug}", style: "font-size: 13px; color: var(--color-text-secondary); text-decoration: none; display: inline-flex; align-items: center; gap: 4px;" do %>
        <span><%= @booking.user.name %> Profili &rarr;</span>
      <% end %>
    </div>

    <div class="booking-box">
      <div class="booking-header" style="text-align: center; padding: 32px 24px;">
      <% case @booking.status %>
      <% when "pending" %>
        <span class="badge badge-pending" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Onay Bekliyor</span>
        <h1 class="booking-title">Randevu Talebiniz Alındı</h1>
        <p>Ev sahibi randevunuzu inceledikten sonra onay durumu güncellenecektir.</p>
        <% if @booking.approval_deadline_at.present? %>
          <div style="margin-top: 12px;" data-controller="countdown" data-countdown-deadline-value="<%= @booking.approval_deadline_at.iso8601 %>">
            <span class="countdown-box">
              Onay için kalan süre: <span>Hesaplanıyor...</span>
            </span>
          </div>
        <% end %>
      <% when "confirmed" %>
        <span class="badge badge-confirmed" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Onaylandı</span>
        <h1 class="booking-title" style="color: var(--color-success);">Randevunuz Onaylandı!</h1>
        <p>Toplantı saatinizde görüşmek üzere.</p>
      <% when "declined" %>
        <span class="badge badge-declined" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Reddedildi</span>
        <h1 class="booking-title">Randevu Reddedildi</h1>
        <p>Ev sahibi bu randevu talebini maalesef kabul edemedi.</p>
      <% when "canceled" %>
        <span class="badge badge-canceled" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">İptal Edildi</span>
        <h1 class="booking-title">Randevu İptal Edildi</h1>
        <p>Bu randevu iptal edilmiştir.</p>
      <% when "expired" %>
        <span class="badge badge-expired" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Süresi Doldu</span>
        <h1 class="booking-title">Randevu Süresi Doldu</h1>
        <p>Onay süresi içerisinde ev sahibi tarafından yanıtlanmadığı için randevu geçersiz kılındı.</p>
      <% when "completed" %>
        <span class="badge badge-completed" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Tamamlandı</span>
        <h1 class="booking-title">Görüşme Tamamlandı</h1>
      <% when "no_show" %>
        <span class="badge badge-danger" style="font-size: 0.9rem; padding: 6px 14px; margin-bottom: 12px;">Katılınmadı</span>
        <h1 class="booking-title">Görüşmeye Katılınmadı</h1>
      <% end %>
    </div>

    <div class="booking-body">
      <div class="card" style="margin-bottom: 24px;">
        <h3 style="margin-bottom: 16px; font-size: 1.1rem; border-bottom: 1px solid var(--color-border); padding-bottom: 8px;">
          Randevu Detayları
        </h3>

        <div style="display: flex; flex-direction: column; gap: 12px;">
          <div>
            <div class="form-label" style="margin-bottom: 2px;">Ev Sahibi</div>
            <div style="font-weight: 600;"><%= @booking.user.name %></div>
          </div>

          <div>
            <div class="form-label" style="margin-bottom: 2px;">Görüşme Türü</div>
            <div style="font-weight: 600;"><%= @booking.event_type.name %> (<%= @booking.event_type.duration_minutes %> dk)</div>
          </div>

          <div>
            <div class="form-label" style="margin-bottom: 2px;">Tarih ve Saat</div>
            <div style="font-weight: 600; color: var(--color-primary); font-size: 1.05rem;">
              <%= @booking.starts_at.in_time_zone("Istanbul").strftime("%d.%m.%Y, %H:%M") %> - <%= @booking.ends_at.in_time_zone("Istanbul").strftime("%H:%M") %>
            </div>
          </div>

          <div>
            <div class="form-label" style="margin-bottom: 2px;">Davetli</div>
            <div><%= @booking.invitee_name %> (<%= @booking.invitee_email %>)</div>
          </div>

          <% if @booking.event_type.location.present? && @booking.confirmed? %>
            <div>
              <div class="form-label" style="margin-bottom: 2px;">Konum / Link</div>
              <div style="font-weight: 600; color: var(--color-primary);">
                <% if @booking.event_type.location.start_with?("http") %>
                  <%= link_to @booking.event_type.location, @booking.event_type.location, target: "_blank" %>
                <% else %>
                  <%= @booking.event_type.location %>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @booking.notes.present? %>
            <div style="grid-column: 1 / -1; background: rgba(99, 102, 241, 0.05); padding: 12px; border-radius: 8px; border-left: 3px solid var(--color-primary); margin-top: 6px;">
              <div class="form-label" style="margin-bottom: 2px; color: var(--color-primary); font-weight: 700;">Davetli Notu / Açıklama:</div>
              <div style="font-size: 13.5px; color: var(--color-text);"><%= simple_format(@booking.notes) %></div>
            </div>
          <% end %>
        </div>
      </div>

      <% if @booking.reschedule_pending? %>
        <div style="margin-top: 16px; padding: 16px; background: #fffbeb; border: 1.5px solid #f59e0b; border-radius: 12px;">
          <% if @booking.rescheduled_by == "host" %>
            <div style="display: flex; gap: 10px; align-items: flex-start;">
              <span style="font-size: 24px;">📢</span>
              <div style="flex: 1;">
                <h4 style="margin: 0 0 6px 0; color: #b45309; font-size: 15px;">Ev Sahibi Yeni Bir Tarih & Saat Önerdi!</h4>
                <p style="margin: 0 0 8px 0; font-size: 13.5px; color: #78350f;">
                  <strong>Yeni Tarih:</strong> <%= @booking.reschedule_starts_at.in_time_zone("Istanbul").strftime("%d %B %Y, %H:%M") %> - <%= @booking.reschedule_ends_at.in_time_zone("Istanbul").strftime("%H:%M") %>
                </p>
                <% if @booking.reschedule_note.present? %>
                  <p style="margin: 0 0 12px 0; font-size: 12.5px; color: #92400e; font-style: italic;">
                    "<%= @booking.reschedule_note %>"
                  </p>
                <% end %>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <%= button_to "✅ Yeni Saati Onayla", accept_reschedule_booking_path(@booking.token), method: :patch, class: "btn btn-sm btn-primary", style: "background: #10b981; border-color: #10b981;" %>
                  <%= button_to "❌ Reddet", reject_reschedule_booking_path(@booking.token), method: :patch, class: "btn btn-sm btn-outline btn-danger" %>
                </div>
              </div>
            </div>
          <% else %>
            <div style="display: flex; gap: 10px; align-items: center;">
              <span style="font-size: 24px;">⏳</span>
              <div>
                <h4 style="margin: 0 0 4px 0; color: #b45309; font-size: 14.5px;">Tarih Değişikliği Talebiniz İnceleniyor</h4>
                <p style="margin: 0; font-size: 13px; color: #78350f;">
                  Talep edilen tarih: <strong><%= @booking.reschedule_starts_at.in_time_zone("Istanbul").strftime("%d %B %Y, %H:%M") %></strong>.<br>
                  Ev sahibi onayladığında randevunuz güncellenecektir.
                </p>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif @booking.reschedule_status == "rejected" %>
        <div style="margin-top: 12px; padding: 10px 14px; background: #fef2f2; border: 1px solid #fca5a5; border-radius: 8px; font-size: 13px; color: #991b1b;">
          ℹ️ Son tarih değişikliği teklifi onaylanmadı. Mevcut randevu saatiniz geçerliliğini korumaktadır.
        </div>
      <% end %>

      <% if @booking.confirmed? %>
        <div style="text-align: center; margin-top: 16px; margin-bottom: 12px;">
          <%= link_to booking_ics_path(@booking.token), class: "btn btn-primary", style: "width: 100%;" do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Takvime Ekle (.ics indir)
          <% end %>
        </div>
      <% end %>

      <% if @booking.status.in?(%w[pending confirmed]) %>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
          <% if @booking.can_reschedule? %>
            <%= link_to reschedule_booking_path(@booking.token), class: "btn btn-outline", style: "width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 6px;" do %>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"></path><path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path><path d="M3 22v-6h6"></path><path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path></svg>
              Tarih / Saat Değiştir (Reschedule)
            <% end %>
          <% end %>

          <%= button_to cancel_booking_path(@booking.token),
                        method: :patch,
                        class: "btn btn-outline btn-danger",
                        style: "width: 100%;",
                        data: { turbo_confirm: "Randevuyu iptal etmek istediğinize emin misiniz?" } do %>
            Randevuyu İptal Et
          <% end %>
        </div>
      <% end %>

      <div style="margin-top: 24px; padding: 16px; background: #f8fafc; border: 1px dashed var(--color-border); border-radius: 12px; text-align: center;">
        <div style="font-weight: 700; font-size: 14px; color: var(--color-text); margin-bottom: 4px;">
          Tüm randevularınızı tek bir ekrandan yönetmek ister misiniz?
        </div>
        <p style="font-size: 12.5px; color: var(--color-text-secondary); margin-bottom: 12px;">
          Danışan & Katılımcı Paneli ile tüm aktif ve geçmiş randevularınızı kolayca takip edebilirsiniz.
        </p>
        <div style="display: flex; gap: 8px; justify-content: center;">
          <%= link_to "Danışan Girişi Yap", login_path, class: "btn btn-sm btn-outline" %>
          <%= link_to "Ücretsiz Hesap Aç", signup_path(role: "client"), class: "btn btn-sm btn-primary" %>
        </div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 18px;">
    <a href="/" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none; color: var(--color-text-secondary); font-size: 13px; font-weight: 500;">
      <span>Powered by</span>
      <img src="/icon.svg" width="16" height="16" alt="Whenly" style="border-radius: 3px;">
      <strong style="color: var(--color-text);">Whenly</strong>
    </a>
  </div>
</div>
</div>
