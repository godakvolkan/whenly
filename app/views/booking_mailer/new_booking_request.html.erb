<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; max-width: 560px; margin: 0 auto; padding: 24px; color: #1e293b; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;">
  <div style="margin-bottom: 20px;">
    <span style="font-size: 20px; font-weight: 800; color: #4f46e5;">Whenly</span>
  </div>

  <div style="background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; font-size: 14px;">
    🔔 Yeni Randevu Talebi Onayınızı Bekliyor
  </div>

  <p style="font-size: 15px; line-height: 1.6;">
    Merhaba <strong><%= @user.name %></strong>,
  </p>
  <p style="font-size: 15px; line-height: 1.6;">
    <strong><%= @booking.invitee_name %></strong> (<%= @booking.invitee_email %>) sizinle bir <strong><%= @event_type.name %></strong> randevusu talep etti.
  </p>

  <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin: 20px 0;">
    <div style="font-size: 13px; color: #64748b; margin-bottom: 4px;">Talep Edilen Zaman</div>
    <div style="font-size: 16px; font-weight: 700; color: #0f172a;">
      <%= @booking.starts_at.in_time_zone("Istanbul").strftime("%d %B %Y, %H:%M") %>
    </div>
    <% if @booking.approval_deadline_at %>
      <div style="font-size: 12px; color: #dc2626; margin-top: 8px; font-weight: 600;">
        ⏰ Onay için son tarih: <%= @booking.approval_deadline_at.in_time_zone("Istanbul").strftime("%d %B %Y, %H:%M") %>
      </div>
    <% end %>
  </div>

  <% if SchedulingRules.repeat_no_show?(@user, @booking.invitee_email) %>
    <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px; border-radius: 8px; font-size: 13px; margin-bottom: 20px;">
      ⚠️ <strong>Dikkat:</strong> Bu davetli geçmişte 2 veya daha fazla kez randevularına katılmamıştır (No-Show). Bu sebeple talep zorunlu onay kuyruğuna alınmıştır.
    </div>
  <% end %>

  <div style="text-align: center; margin: 28px 0;">
    <a href="<%= @dashboard_url %>" style="display: inline-block; background: #4f46e5; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 8px; font-weight: 600; font-size: 14px;">
      Panele Git ve Talebi İncele
    </a>
  </div>

  <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 24px 0;">
  <div style="font-size: 12px; color: #94a3b8; text-align: center;">
    Whenly — Ev Sahibi Kontrollü Randevu Sistemi
  </div>
</div>
